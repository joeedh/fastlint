{
  "version"             : 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name"          : "base",
      "hidden"        : true,
      "generator"     : "Ninja",
      "binaryDir"     : "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name"          : "debug",
      "inherits"      : "base",
      "displayName"   : "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name"          : "release",
      "inherits"      : "base",
      "displayName"   : "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE"       : "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Zi /DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS" : "/DEBUG /OPT:REF /OPT:ICF"
      }
    },
    {
      "name"          : "relwithdebinfo",
      "inherits"      : "base",
      "displayName"   : "RelWithDebInfo",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name"          : "asan",
      "inherits"      : "base",
      "displayName"   : "MSVC AddressSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE"      : "RelWithDebInfo",
        "CMAKE_CXX_FLAGS"       : "/DWIN32 /D_WINDOWS /EHsc /fsanitize=address /Zi",
        "CMAKE_EXE_LINKER_FLAGS": "/DEBUG /INCREMENTAL:NO"
      }
    },
    {
      "name"          : "clang-asan",
      "inherits"      : "base",
      "displayName"   : "clang-cl AddressSanitizer + UBSan",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE"      : "${sourceDir}/cmake/ClangAsanToolchain.cmake",
        "CMAKE_BUILD_TYPE"          : "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc -fsanitize=address,undefined /Oy- /Zi",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "clang-asan", "configurePreset": "clang-asan" }
  ],
  "testPresets": [
    {
      "name"           : "debug",
      "configurePreset": "debug",
      "output"         : { "outputOnFailure": true }
    },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
