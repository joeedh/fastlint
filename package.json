{
  "name": "fastlint",
  "version": "0.1.0",
  "type": "module",
  "description": "A fast TypeScript/JavaScript linter written in C++",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fastlint": "dist/ts/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "default": "./dist/ts/index.js"
    },
    "./schema.json": "./schema/fastlint.config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "docs/rules.md",
    "docs/plugins.md"
  ],
  "scripts": {
    "make": "node make.ts",
    "prepack": "node make.ts pack"
  },
  "devDependencies": {
    "@pathtx/prettier": "^3.3.0-dev",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.33",
    "cmake-js": "^7.3.0",
    "comment-lint": "^0.5.0",
    "typescript": "^7.0.2",
    "yargs": "^18.0.0"
  }
}
