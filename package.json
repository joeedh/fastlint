{
  "name": "lintrix",
  "version": "0.1.0",
  "type": "module",
  "description": "A fast TypeScript/JavaScript linter written in C++",
  "license": "MIT",
  "author": "Joe Eagar",
  "keywords": [
    "lint",
    "linter",
    "typescript",
    "javascript",
    "eslint",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeedh/fastlint.git"
  },
  "homepage": "https://github.com/joeedh/fastlint#readme",
  "bugs": "https://github.com/joeedh/fastlint/issues",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "lintrix": "dist/ts/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "default": "./dist/ts/index.js"
    },
    "./schema.json": "./schema/lintrix.config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "docs/rules.md",
    "docs/plugins.md"
  ],
  "scripts": {
    "make": "node make.ts",
    "prepack": "node make.ts pack"
  },
  "devDependencies": {
    "@pathtx/prettier": "^3.3.0-dev",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.33",
    "cmake-js": "^7.3.0",
    "comment-lint": "^0.5.0",
    "typescript": "^7.0.2",
    "yargs": "^18.0.0"
  }
}
