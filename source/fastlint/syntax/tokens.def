// Single source of truth for the token kinds the scanner emits.
// Included twice from tokens.h with FASTLINT_TOKEN(kind, name) defined.

FASTLINT_TOKEN(EndOfFile, "end_of_file")

// Words and literals.
FASTLINT_TOKEN(Identifier, "identifier")
FASTLINT_TOKEN(PrivateIdentifier, "private_identifier")
FASTLINT_TOKEN(JsxIdentifier, "jsx_identifier")
FASTLINT_TOKEN(JsxText, "jsx_text")
FASTLINT_TOKEN(NumericLiteral, "numeric_literal")
FASTLINT_TOKEN(BigIntLiteral, "bigint_literal")
FASTLINT_TOKEN(StringLiteral, "string_literal")
FASTLINT_TOKEN(RegularExpressionLiteral, "regex_literal")
FASTLINT_TOKEN(NoSubstitutionTemplateLiteral, "no_substitution_template")
FASTLINT_TOKEN(TemplateHead, "template_head")
FASTLINT_TOKEN(TemplateMiddle, "template_middle")
FASTLINT_TOKEN(TemplateTail, "template_tail")
FASTLINT_TOKEN(TemplateInvalid, "template_invalid")

// Keywords. Contextual keywords come back as their keyword kind too; the
// parser decides whether the context accepts them as identifiers.
FASTLINT_TOKEN(AbstractKeyword, "abstract")
FASTLINT_TOKEN(AccessorKeyword, "accessor")
FASTLINT_TOKEN(AnyKeyword, "any")
FASTLINT_TOKEN(AsKeyword, "as")
FASTLINT_TOKEN(AssertKeyword, "assert")
FASTLINT_TOKEN(AssertsKeyword, "asserts")
FASTLINT_TOKEN(AsyncKeyword, "async")
FASTLINT_TOKEN(AwaitKeyword, "await")
FASTLINT_TOKEN(BigIntKeyword, "bigint")
FASTLINT_TOKEN(BooleanKeyword, "boolean")
FASTLINT_TOKEN(BreakKeyword, "break")
FASTLINT_TOKEN(CaseKeyword, "case")
FASTLINT_TOKEN(CatchKeyword, "catch")
FASTLINT_TOKEN(ClassKeyword, "class")
FASTLINT_TOKEN(ContinueKeyword, "continue")
FASTLINT_TOKEN(ConstKeyword, "const")
FASTLINT_TOKEN(ConstructorKeyword, "constructor")
FASTLINT_TOKEN(DebuggerKeyword, "debugger")
FASTLINT_TOKEN(DeclareKeyword, "declare")
FASTLINT_TOKEN(DefaultKeyword, "default")
FASTLINT_TOKEN(DeleteKeyword, "delete")
FASTLINT_TOKEN(DoKeyword, "do")
FASTLINT_TOKEN(ElseKeyword, "else")
FASTLINT_TOKEN(EnumKeyword, "enum")
FASTLINT_TOKEN(ExportKeyword, "export")
FASTLINT_TOKEN(ExtendsKeyword, "extends")
FASTLINT_TOKEN(FalseKeyword, "false")
FASTLINT_TOKEN(FinallyKeyword, "finally")
FASTLINT_TOKEN(ForKeyword, "for")
FASTLINT_TOKEN(FromKeyword, "from")
FASTLINT_TOKEN(FunctionKeyword, "function")
FASTLINT_TOKEN(GetKeyword, "get")
FASTLINT_TOKEN(GlobalKeyword, "global")
FASTLINT_TOKEN(IfKeyword, "if")
FASTLINT_TOKEN(ImplementsKeyword, "implements")
FASTLINT_TOKEN(ImportKeyword, "import")
FASTLINT_TOKEN(InKeyword, "in")
FASTLINT_TOKEN(InferKeyword, "infer")
FASTLINT_TOKEN(InstanceOfKeyword, "instanceof")
FASTLINT_TOKEN(InterfaceKeyword, "interface")
FASTLINT_TOKEN(IntrinsicKeyword, "intrinsic")
FASTLINT_TOKEN(IsKeyword, "is")
FASTLINT_TOKEN(KeyOfKeyword, "keyof")
FASTLINT_TOKEN(LetKeyword, "let")
FASTLINT_TOKEN(ModuleKeyword, "module")
FASTLINT_TOKEN(NamespaceKeyword, "namespace")
FASTLINT_TOKEN(NeverKeyword, "never")
FASTLINT_TOKEN(NewKeyword, "new")
FASTLINT_TOKEN(NullKeyword, "null")
FASTLINT_TOKEN(NumberKeyword, "number")
FASTLINT_TOKEN(ObjectKeyword, "object")
FASTLINT_TOKEN(OfKeyword, "of")
FASTLINT_TOKEN(OutKeyword, "out")
FASTLINT_TOKEN(OverrideKeyword, "override")
FASTLINT_TOKEN(PackageKeyword, "package")
FASTLINT_TOKEN(PrivateKeyword, "private")
FASTLINT_TOKEN(ProtectedKeyword, "protected")
FASTLINT_TOKEN(PublicKeyword, "public")
FASTLINT_TOKEN(ReadOnlyKeyword, "readonly")
FASTLINT_TOKEN(RequireKeyword, "require")
FASTLINT_TOKEN(ReturnKeyword, "return")
FASTLINT_TOKEN(SatisfiesKeyword, "satisfies")
FASTLINT_TOKEN(SetKeyword, "set")
FASTLINT_TOKEN(StaticKeyword, "static")
FASTLINT_TOKEN(StringKeyword, "string")
FASTLINT_TOKEN(SuperKeyword, "super")
FASTLINT_TOKEN(SwitchKeyword, "switch")
FASTLINT_TOKEN(SymbolKeyword, "symbol")
FASTLINT_TOKEN(ThisKeyword, "this")
FASTLINT_TOKEN(ThrowKeyword, "throw")
FASTLINT_TOKEN(TrueKeyword, "true")
FASTLINT_TOKEN(TryKeyword, "try")
FASTLINT_TOKEN(TypeKeyword, "type")
FASTLINT_TOKEN(TypeOfKeyword, "typeof")
FASTLINT_TOKEN(UndefinedKeyword, "undefined")
FASTLINT_TOKEN(UniqueKeyword, "unique")
FASTLINT_TOKEN(UnknownKeyword, "unknown")
FASTLINT_TOKEN(UsingKeyword, "using")
FASTLINT_TOKEN(VarKeyword, "var")
FASTLINT_TOKEN(VoidKeyword, "void")
FASTLINT_TOKEN(WhileKeyword, "while")
FASTLINT_TOKEN(WithKeyword, "with")
FASTLINT_TOKEN(YieldKeyword, "yield")

// Punctuation and operators.
FASTLINT_TOKEN(OpenBraceToken, "{")
FASTLINT_TOKEN(CloseBraceToken, "}")
FASTLINT_TOKEN(OpenParenToken, "(")
FASTLINT_TOKEN(CloseParenToken, ")")
FASTLINT_TOKEN(OpenBracketToken, "[")
FASTLINT_TOKEN(CloseBracketToken, "]")
FASTLINT_TOKEN(DotToken, ".")
FASTLINT_TOKEN(DotDotDotToken, "...")
FASTLINT_TOKEN(SemicolonToken, ";")
FASTLINT_TOKEN(CommaToken, ",")
FASTLINT_TOKEN(ColonToken, ":")
FASTLINT_TOKEN(ColonColonToken, "::")
FASTLINT_TOKEN(QuestionDotToken, "?.")
FASTLINT_TOKEN(QuestionQuestionToken, "??")
FASTLINT_TOKEN(QuestionQuestionEqualsToken, "?" "?" "=")
FASTLINT_TOKEN(QuestionToken, "?")
FASTLINT_TOKEN(LessThanToken, "<")
FASTLINT_TOKEN(LessThanEqualsToken, "<=")
FASTLINT_TOKEN(GreaterThanToken, ">")
FASTLINT_TOKEN(GreaterThanEqualsToken, ">=")
FASTLINT_TOKEN(LessThanLessThanToken, "<<")
FASTLINT_TOKEN(LessThanLessThanEqualsToken, "<<=")
FASTLINT_TOKEN(GreaterThanGreaterThanToken, ">>")
FASTLINT_TOKEN(GreaterThanGreaterThanEqualsToken, ">>=")
FASTLINT_TOKEN(GreaterThanGreaterThanGreaterThanToken, ">>>")
FASTLINT_TOKEN(GreaterThanGreaterThanGreaterThanEqualsToken, ">>>=")
FASTLINT_TOKEN(EqualsEqualsEqualsToken, "===")
FASTLINT_TOKEN(EqualsEqualsToken, "==")
FASTLINT_TOKEN(EqualsToken, "=")
FASTLINT_TOKEN(ExclamationEqualsEqualsToken, "!==")
FASTLINT_TOKEN(ExclamationEqualsToken, "!=")
FASTLINT_TOKEN(ExclamationToken, "!")
FASTLINT_TOKEN(EqualsGreaterThanToken, "=>")
FASTLINT_TOKEN(PlusToken, "+")
FASTLINT_TOKEN(MinusToken, "-")
FASTLINT_TOKEN(PlusPlusToken, "++")
FASTLINT_TOKEN(MinusMinusToken, "--")
FASTLINT_TOKEN(PlusEqualsToken, "+=")
FASTLINT_TOKEN(MinusEqualsToken, "-=")
FASTLINT_TOKEN(AsteriskToken, "*")
FASTLINT_TOKEN(AsteriskAsteriskToken, "**")
FASTLINT_TOKEN(AsteriskEqualsToken, "*=")
FASTLINT_TOKEN(AsteriskAsteriskEqualsToken, "**=")
FASTLINT_TOKEN(SlashToken, "/")
FASTLINT_TOKEN(SlashEqualsToken, "/=")
FASTLINT_TOKEN(PercentToken, "%")
FASTLINT_TOKEN(PercentEqualsToken, "%=")
FASTLINT_TOKEN(AmpersandToken, "&")
FASTLINT_TOKEN(AmpersandAmpersandToken, "&&")
FASTLINT_TOKEN(AmpersandAmpersandEqualsToken, "&&=")
FASTLINT_TOKEN(AmpersandEqualsToken, "&=")
FASTLINT_TOKEN(PipeToken, "|")
FASTLINT_TOKEN(PipePipeToken, "||")
FASTLINT_TOKEN(PipePipeEqualsToken, "||=")
FASTLINT_TOKEN(PipeEqualsToken, "|=")
FASTLINT_TOKEN(CaretToken, "^")
FASTLINT_TOKEN(CaretEqualsToken, "^=")
FASTLINT_TOKEN(TildeToken, "~")
FASTLINT_TOKEN(AtToken, "@")
FASTLINT_TOKEN(BacktickToken, "`")
FASTLINT_TOKEN(HashToken, "#")
